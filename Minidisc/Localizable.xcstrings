            "value" : "AudioMuse"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse"
          }
        }
      }
    },
    "AudioMuse found tracks, but none of them exist in your music library. Is it analysing the same collection?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse hat Titel gefunden, von denen keiner in deiner Musikbibliothek existiert. Analysiert es dieselbe Sammlung?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AudioMuse βρήκε κομμάτια, αλλά κανένα από αυτά δεν υπάρχει στη μουσική σου βιβλιοθήκη. Αναλύει την ίδια συλλογή;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse encontró pistas, pero ninguna existe en tu biblioteca musical. ¿Está analizando la misma colección?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse a trouvé des morceaux, mais aucun n'existe dans ta bibliothèque musicale. Analyse-t-il bien la même collection ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse ha trovato dei brani, ma nessuno esiste nella tua libreria musicale. Sta analizzando la stessa collezione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuseは楽曲を見つけましたが、いずれもあなたのライブラリに存在しません。同じコレクションを解析していますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse 找到了曲目，但它们都不在你的音乐库中。它分析的是同一批音乐吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse 找到了曲目，但它們都不在你的音樂庫中。它分析的是同一批音樂嗎？"
          }
        }
      }
    },
    "AudioMuse has not analysed your library yet. Run an analysis, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse hat deine Bibliothek noch nicht analysiert. Führe eine Analyse aus und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AudioMuse δεν έχει αναλύσει ακόμη τη βιβλιοθήκη σου. Εκτέλεσε μια ανάλυση και δοκίμασε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse aún no ha analizado tu biblioteca. Ejecuta un análisis y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse n'a pas encore analysé ta bibliothèque. Lance une analyse, puis réessaie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse non ha ancora analizzato la tua libreria. Esegui un'analisi e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuseはまだライブラリを解析していません。解析を実行してから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse 尚未分析你的音乐库。请先运行分析，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse 尚未分析你的音樂庫。請先執行分析，然後重試。"
          }
        }
      }
    },
    "AudioMuse-AI analyses how your music actually sounds, which lets Minidisc build a playlist for a mood rather than for a tag." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse-AI analysiert, wie deine Musik tatsächlich klingt. So kann Minidisc eine Playlist für eine Stimmung erstellen statt für ein Tag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AudioMuse-AI αναλύει πώς ακούγεται πραγματικά η μουσική σου, ώστε το Minidisc να φτιάχνει λίστα για μια διάθεση αντί για μια ετικέτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse-AI analiza cómo suena realmente tu música, lo que permite a Minidisc crear una lista para un estado de ánimo en vez de para una etiqueta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse-AI analyse la sonorité réelle de ta musique, ce qui permet à Minidisc de construire une playlist pour une ambiance plutôt que pour un tag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse-AI analizza come suona davvero la tua musica, così Minidisc può creare una playlist per un'atmosfera anziché per un tag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse-AIは楽曲の実際の響きを解析します。タグではなくムードでプレイリストを作れるようになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse-AI 分析音乐的实际听感，让 Minidisc 能按心情而非标签生成播放列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioMuse-AI 分析音樂的實際聽感，讓 Minidisc 能依心情而非標籤產生播放列表。"
          }
        }
      }
    },
