    "Moves the files into your library and frees the download folder. Stops seeding." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Dateien in deine Bibliothek und leert den Download-Ordner. Beendet das Seeding."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινεί τα αρχεία στη βιβλιοθήκη σου και ελευθερώνει τον φάκελο λήψεων. Σταματά τον διαμοιρασμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve los archivos a tu biblioteca y libera la carpeta de descargas. Deja de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace les fichiers dans votre bibliothèque et libère le dossier de téléchargement. Arrête le seed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
