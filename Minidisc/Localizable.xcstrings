    "Recently-played music is removed from the cache. It re-downloads on demand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kürzlich gespielte Musik wird aus dem Cache entfernt. Sie wird bei Bedarf erneut geladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μουσική που αναπαράχθηκε πρόσφατα αφαιρείται από την προσωρινή μνήμη. Λαμβάνεται ξανά όταν χρειάζεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música reproducida recientemente se elimina de la caché. Se vuelve a descargar cuando se necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique récemment écoutée est retirée du cache. Elle se retélécharge à la demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musica riprodotta di recente viene rimossa dalla cache. Viene riscaricata all'occorrenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近再生した曲がキャッシュから削除されます。必要に応じて再ダウンロードされます。"
