{
  "sourceLanguage": "en",
  "strings": {
    "Open Minidisc on your iPhone to finish setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Minidisc on your iPhone to finish setup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Minidisc sur votre iPhone pour terminer la configuration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Minidisc auf deinem iPhone, um die Einrichtung abzuschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Minidisc στο iPhone για να ολοκληρώσετε τη ρύθμιση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Minidisc en tu iPhone para terminar la configuración."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Minidisc sul tuo iPhone per completare la configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでMinidiscを開いて設定を完了してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 Minidisc 以完成设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上開啟 Minidisc 以完成設定。"
          }
        }
      }
    },
    "Server unavailable. Showing music on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server unavailable. Showing music on this iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur indisponible. Musique disponible sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar. Musik auf diesem iPhone wird angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν είναι διαθέσιμος. Εμφανίζεται η μουσική αυτού του iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor no disponible. Se muestra la música de este iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Server non disponibile. Viene mostrata la musica su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できません。このiPhone内の音楽を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不可用。正在显示此 iPhone 上的音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器無法使用。正在顯示此 iPhone 上的音樂。"
          }
        }
      }
    },
