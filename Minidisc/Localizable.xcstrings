    "Mood playlists refresh once a week, from Wednesday onwards, the next time you open Minidisc." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmungs-Playlists werden einmal pro Woche aktualisiert, ab Mittwoch, beim nächsten Öffnen von Minidisc."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λίστες διάθεσης ανανεώνονται μία φορά την εβδομάδα, από την Τετάρτη και μετά, την επόμενη φορά που θα ανοίξεις το Minidisc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas por estado de ánimo se actualizan una vez por semana, a partir del miércoles, la próxima vez que abras Minidisc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les playlists d'ambiance se mettent à jour une fois par semaine, à partir du mercredi, à ta prochaine ouverture de Minidisc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le playlist per atmosfera si aggiornano una volta a settimana, da mercoledì in poi, alla prossima apertura di Minidisc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ムードのプレイリストは週に一度、水曜日以降にMinidiscを次に開いたときに更新されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情播放列表每周更新一次，自周三起，在你下次打开 Minidisc 时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情播放列表每週更新一次，自週三起，在你下次開啟 Minidisc 時生效。"
          }
        }
      }
    },
