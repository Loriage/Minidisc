          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbum desconocido"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Album sconosciuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なアルバム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知专辑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知專輯"
          }
        }
      }
    },
    "Your files stay in place. Removing a folder from Minidisc does not delete them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files stay in place. Removing a folder from Minidisc does not delete them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers restent à leur emplacement. Retirer un dossier de Minidisc ne les supprime pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien bleiben an ihrem Speicherort. Wenn du einen Ordner aus Minidisc entfernst, werden seine Dateien nicht gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχεία σας παραμένουν στη θέση τους. Η αφαίρεση ενός φακέλου από το Minidisc δεν τα διαγράφει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos permanecen en su ubicación. Quitar una carpeta de Minidisc no los elimina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file restano nella loro posizione. Rimuovere una cartella da Minidisc non li elimina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは元の場所に保存されたままです。Minidiscからフォルダを削除しても、ファイルは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会保留在原位置。从 Minidisc 移除文件夹不会删除其中的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會保留在原位置。從 Minidisc 移除檔案夾不會刪除其中的檔案。"
          }
        }
      }
    },
    "Download cloud files in Files before playing them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download cloud files in Files before playing them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez les fichiers du cloud dans Fichiers avant de les lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Dateien aus der Cloud vor der Wiedergabe in der App Dateien herunter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατεβάστε τα αρχεία από το cloud στην εφαρμογή Αρχεία πριν από την αναπαραγωγή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga los archivos de la nube en Archivos antes de reproducirlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica i file dal cloud nell’app File prima di riprodurli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上のファイルは、再生する前に「ファイル」でダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放前，请先在“文件”中下载云端文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放前，請先在「檔案」中下載雲端檔案。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
