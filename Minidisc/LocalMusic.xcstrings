    "Unavailable on this device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät nicht verfügbar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη διαθέσιμο σε αυτή τη συσκευή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable on this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible sur cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは利用できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上無法使用"
          }
        }
      }
    },
    "Add music folders from Files. Your audio stays where it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Musikordner aus Dateien hinzu. Deine Audiodateien bleiben an ihrem Speicherort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε φακέλους μουσικής από τα Αρχεία. Τα αρχεία ήχου παραμένουν στη θέση τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music folders from Files. Your audio stays where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade carpetas de música desde Archivos. Tus archivos de audio permanecen en su ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des dossiers de musique depuis Fichiers. Vos fichiers audio restent à leur emplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi cartelle musicali da File. I tuoi file audio restano nella loro posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」から音楽フォルダを追加します。音声ファイルは元の場所に保存されたままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“文件”添加音乐文件夹。音频文件会保留在原位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「檔案」加入音樂檔案夾。音訊檔案會保留在原位置。"
          }
        }
      }
    },
    "Folder unavailable. Add it again to restore access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner nicht verfügbar. Füge ihn erneut hinzu, um den Zugriff wiederherzustellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο φάκελος δεν είναι διαθέσιμος. Προσθέστε τον ξανά για επαναφορά της πρόσβασης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder unavailable. Add it again to restore access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta no disponible. Añádela de nuevo para recuperar el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier indisponible. Ajoutez-le à nouveau pour rétablir l’accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella non disponibile. Aggiungila di nuovo per ripristinare l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを利用できません。再度追加してアクセスを復元してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹不可用。请重新添加以恢复访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾無法使用。請重新加入以恢復存取。"
          }
        }
      }
    },
    "No audio files found. Check your folders in Files, then refresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Audiodateien gefunden. Prüfe deine Ordner in Dateien und aktualisiere dann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν αρχεία ήχου. Ελέγξτε τους φακέλους σας στα Αρχεία και ανανεώστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio files found. Check your folders in Files, then refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron archivos de audio. Comprueba tus carpetas en Archivos y actualiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier audio trouvé. Vérifiez vos dossiers dans Fichiers, puis actualisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file audio trovato. Controlla le cartelle in File, poi aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ファイルが見つかりません。「ファイル」でフォルダを確認し、更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到音频文件。请在“文件”中检查文件夹，然后刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到音訊檔案。請在「檔案」中檢查檔案夾，然後重新整理。"
          }
        }
      }
    },
    "This audio file cannot be played on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Audiodatei kann auf diesem Gerät nicht abgespielt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο ήχου δεν μπορεί να αναπαραχθεί σε αυτή τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio file cannot be played on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo de audio no se puede reproducir en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier audio ne peut pas être lu sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file audio non può essere riprodotto su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声ファイルは、このデバイスでは再生できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此设备上播放此音频文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此裝置上播放此音訊檔案。"
          }
        }
      }
    },
    "This file is unavailable. Download or restore it in Files, then refresh Minidisc.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist nicht verfügbar. Lade sie in Dateien herunter oder stelle sie wieder her und aktualisiere dann Minidisc."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο δεν είναι διαθέσιμο. Κατεβάστε το ή επαναφέρετέ το στα Αρχεία και ανανεώστε το Minidisc."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is unavailable. Download or restore it in Files, then refresh Minidisc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no está disponible. Descárgalo o restáuralo en Archivos y actualiza Minidisc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est indisponible. Téléchargez-le ou restaurez-le dans Fichiers, puis actualisez Minidisc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è disponibile. Scaricalo o ripristinalo in File, poi aggiorna Minidisc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを利用できません。「ファイル」でダウンロードまたは復元してから、Minidiscを更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不可用。请在“文件”中下载或恢复它，然后刷新 Minidisc。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案無法使用。請在「檔案」中下載或回復它，然後重新整理 Minidisc。"
          }
        }
      }
    },
    "This folder is unavailable. Check its location and permissions in Files, or add it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist nicht verfügbar. Prüfe seinen Speicherort und seine Zugriffsrechte in Dateien oder füge ihn erneut hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος δεν είναι διαθέσιμος. Ελέγξτε τη θέση και τα δικαιώματά του στα Αρχεία ή προσθέστε τον ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is unavailable. Check its location and permissions in Files, or add it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta no está disponible. Comprueba su ubicación y sus permisos en Archivos o añádela de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est indisponible. Vérifiez son emplacement et ses autorisations dans Fichiers, ou ajoutez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella non è disponibile. Controlla la sua posizione e i permessi in File oppure aggiungila di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダを利用できません。「ファイル」で場所とアクセス権を確認するか、再度追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹不可用。请在“文件”中检查其位置和权限，或重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾無法使用。請在「檔案」中檢查其位置和權限，或重新加入。"
          }
        }
      }
    },
    "Unknown Album": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown Album"
          }
        },
        "fr": {
          "stringUnit": {
