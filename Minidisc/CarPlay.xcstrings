    "Add music or connect a server in Minidisc on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music or connect a server in Minidisc on your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez de la musique ou connectez un serveur dans Minidisc sur votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Musik hinzu oder verbinde einen Server in Minidisc auf deinem iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μουσική ή συνδέστε έναν διακομιστή στο Minidisc στο iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade música o conecta un servidor en Minidisc en tu iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi musica o collega un server in Minidisc sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのMinidiscで音楽を追加するか、サーバーに接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Minidisc 中添加音乐或连接服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Minidisc 中加入音樂或連接伺服器。"
          }
        }
      }
    },
    "No music available here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No music available here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune musique disponible ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist keine Musik verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει διαθέσιμη μουσική εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay música disponible aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna musica disponibile qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここには再生できる音楽がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处没有可用的音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處沒有可播放的音樂。"
          }
        }
      }
    },
    "No tracks in the queue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tracks in the queue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun morceau dans la file d’attente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Titel in der Warteschlange."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν κομμάτια στην ουρά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay canciones en la cola."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun brano in coda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューに曲がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放队列中没有歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待播清單中沒有歌曲。"
          }
        }
      }
    },
    "Play All": {
      "extractionState": "manual",
