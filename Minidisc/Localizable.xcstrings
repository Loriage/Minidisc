    "Evens out the volume between tracks. Track mode levels each song on its own, and Album mode keeps an album's dynamics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicht die Lautstärke zwischen Titeln an. Der Titel-Modus pegelt jeden Song einzeln, der Album-Modus bewahrt die Dynamik eines Albums."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξισορροπεί την ένταση μεταξύ των κομματιών. Η λειτουργία Κομμάτι ρυθμίζει κάθε τραγούδι ξεχωριστά, ενώ η λειτουργία Άλμπουμ διατηρεί τη δυναμική του άλμπουμ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivela el volumen entre pistas. El modo Pista ajusta cada canción por separado y el modo Álbum conserva la dinámica del álbum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniformise le volume entre les morceaux. Le mode Piste ajuste chaque titre individuellement, tandis que le mode Album préserve la dynamique de l’album."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniforma il volume tra le tracce. La modalità Traccia livella ogni brano singolarmente, mentre la modalità Album mantiene la dinamica dell'album."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲間の音量を均一にします。トラックモードは各曲を個別に調整し、アルバムモードはアルバムのダイナミクスを保ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平衡不同曲目之间的音量。曲目模式单独调整每首歌，专辑模式则保留专辑的动态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平衡不同曲目之間的音量。曲目模式單獨調整每首歌，專輯模式則保留專輯的動態。"
          }
        }
      }
    },
    "Every downloaded album and playlist is deleted. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle heruntergeladenen Alben und Playlists werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε ληφθέν άλμπουμ και λίστα αναπαραγωγής διαγράφεται. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan todos los álbumes y listas descargados. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les albums et listes de lecture téléchargés sont supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli album e le playlist scaricati vengono eliminati. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みのすべてのアルバムとプレイリストが削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有已下载的专辑和播放列表都将被删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有已下載的專輯和播放列表都將被刪除。此操作無法復原。"
          }
        }
      }
    },
