    "Covers re-download on demand. Turning caching off keeps artwork in memory only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cover werden bei Bedarf erneut geladen. Ohne Cache bleibt das Cover nur im Arbeitsspeicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα εξώφυλλα λαμβάνονται ξανά όταν χρειάζεται. Απενεργοποιώντας την προσωρινή μνήμη, τα εξώφυλλα μένουν μόνο στη μνήμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carátulas se vuelven a descargar cuando se necesitan. Al desactivar la caché, las carátulas solo se guardan en memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pochettes se retéléchargent à la demande. Désactiver le cache garde les pochettes en mémoire uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copertine vengono riscaricate all'occorrenza. Disattivando la cache, le copertine restano solo in memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カバーは必要に応じて再ダウンロードされます。キャッシュをオフにすると、アートワークはメモリ内にのみ保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封面会按需重新下载。关闭缓存后，封面仅保留在内存中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封面會依需求重新下載。關閉快取後，封面僅保留在記憶體中。"
          }
        }
      }
    },
