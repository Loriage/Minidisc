    "Lidarr could not match this release to an artist and album, so it may not import on its own. Grab it anyway?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr konnte dieses Release keinem Künstler und Album zuordnen und importiert es daher möglicherweise nicht automatisch. Trotzdem abrufen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr δεν μπόρεσε να αντιστοιχίσει αυτή την κυκλοφορία με καλλιτέχνη και άλμπουμ, οπότε ίσως να μην εισαχθεί από μόνη της. Λήψη ούτως ή άλλως;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr no pudo asociar este lanzamiento con un artista y un álbum, por lo que puede que no se importe por sí solo. ¿Obtenerlo de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr n'a pas pu associer cette sortie à un artiste et un album, elle risque donc de ne pas s'importer d'elle-même. La récupérer quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr non è riuscito ad associare questa release a un artista e a un album, quindi potrebbe non importarsi da sola. Prelevarla comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarrはこのリリースをアーティストとアルバムに一致させられなかったため、自動ではインポートされない可能性があります。それでも取得しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 无法将此发行版匹配到艺人和专辑，因此可能不会自动导入。仍要抓取吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr 無法將此發行版匹配到藝人和專輯，因此可能不會自動匯入。仍要抓取嗎？"
          }
        }
      }
    },
    "Lidarr could not parse this release. Choose the album it belongs to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr konnte dieses Release nicht analysieren. Wähle das zugehörige Album."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr δεν μπόρεσε να αναλύσει αυτή την κυκλοφορία. Επιλέξτε το άλμπουμ στο οποίο ανήκει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr no pudo analizar este lanzamiento. Elige el álbum al que pertenece."
