    "Lidarr picks: it moves the files, or copies them when the download is still seeding." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr entscheidet: Es verschiebt die Dateien oder kopiert sie, wenn der Download noch seedet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lidarr αποφασίζει: μετακινεί τα αρχεία ή τα αντιγράφει όταν η λήψη συνεχίζει να διαμοιράζεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr decide: mueve los archivos, o los copia si la descarga sigue compartiéndose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr décide : il déplace les fichiers, ou les copie si le téléchargement est encore en seed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr decide: sposta i file, oppure li copia se il download è ancora in seeding."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidarr が判断します。ファイルを移動するか、シード中の場合はコピーします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 Lidarr 决定：移动文件，或在下载仍在做种时复制文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 Lidarr 決定：移動檔案，或在下載項目仍在做種時複製檔案。"
          }
        }
      }
    },
