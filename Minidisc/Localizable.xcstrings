    "Minidisc couldn't open its local data. You can try again without restarting the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc konnte seine lokalen Daten nicht öffnen. Du kannst es erneut versuchen, ohne die App neu zu starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Minidisc δεν μπόρεσε να ανοίξει τα τοπικά δεδομένα του. Μπορείτε να δοκιμάσετε ξανά χωρίς επανεκκίνηση της εφαρμογής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc no ha podido abrir sus datos locales. Puedes volver a intentarlo sin reiniciar la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc n’a pas pu ouvrir ses données locales. Vous pouvez réessayer sans redémarrer l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc non è riuscito ad aprire i dati locali. Puoi riprovare senza riavviare l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidiscはローカルデータを開けませんでした。アプリを再起動せずに再試行できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc 无法打开本地数据。你可以直接重试，无需重新启动 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc 無法開啟本機資料。你可以直接重試，無需重新啟動 App。"
          }
        }
      }
    },
    "Minidisc forgets the address and the API key. Your Lidarr instance is not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc vergisst die Adresse und den API-Schlüssel. Deine Lidarr-Instanz wird nicht verändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Minidisc ξεχνά τη διεύθυνση και το κλειδί API. Η παρουσία Lidarr σας δεν αλλάζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc olvida la dirección y la clave API. Tu instancia de Lidarr no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc oublie l'adresse et la clé API. Votre instance Lidarr n'est pas modifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minidisc dimentica l'indirizzo e la chiave API. La tua istanza Lidarr non viene modificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
