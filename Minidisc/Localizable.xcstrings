    "Songs you favorite from this artist will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Lieblingssongs dieses Artists erscheinen hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τραγούδια αυτού του καλλιτέχνη που προσθέτεις στα αγαπημένα θα εμφανίζονται εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones de este artista que marques como favoritas aparecerán aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres de cet artiste que vous ajoutez aux favoris apparaîtront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani di questo artista che aggiungi ai preferiti appariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアーティストのお気に入りに追加した曲がここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你收藏的这位艺人的歌曲会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你收藏的這位藝人的歌曲會顯示在這裡。"
          }
        }
      }
    },
    "Songs, albums, and artists you favorite will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
