        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρότυπο URL πρέπει να περιέχει %s — αντικαθίσταται από το \"Artist Album\" κατά το άνοιγμα μιας κυκλοφορίας."
          }
        },
        "es" : {
          "stringUnit" : {
