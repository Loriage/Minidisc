    "URL template must contain %s — replaced by \"Artist Album\" when opening a release." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die URL-Vorlage muss %s enthalten — wird beim Öffnen einer Veröffentlichung durch \"Artist Album\" ersetzt."
          }
