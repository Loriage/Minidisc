    "Optional headers sent with every request — useful for Cloudflare Access or other reverse-proxy authentication." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Header, die mit jeder Anfrage gesendet werden — nützlich für Cloudflare Access oder andere Reverse-Proxy-Authentifizierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προαιρετικές κεφαλίδες που αποστέλλονται με κάθε αίτημα — χρήσιμες για το Cloudflare Access ή άλλη ταυτοποίηση μέσω reverse-proxy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeceras opcionales enviadas con cada solicitud: útiles para Cloudflare Access u otra autenticación de proxy inverso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En-têtes facultatifs envoyés à chaque requête — utiles pour Cloudflare Access ou d'autres authentifications par reverse proxy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intestazioni opzionali inviate con ogni richiesta — utili per Cloudflare Access o altre autenticazioni tramite reverse proxy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのリクエストに送信されるオプションのヘッダ — Cloudflare Accessやその他のリバースプロキシ認証に便利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随每个请求发送的可选请求头 — 适用于 Cloudflare Access 或其他反向代理身份验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨每個請求傳送的選用標頭——適用於 Cloudflare Access 或其他反向代理驗證。"
          }
        }
      }
    },
    "Optional headers sent with every request. Use them if Lidarr is behind a reverse proxy, for example Cloudflare Access or Authelia." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Header, die mit jeder Anfrage gesendet werden. Verwende sie, wenn Lidarr hinter einem Reverse-Proxy läuft, zum Beispiel Cloudflare Access oder Authelia."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προαιρετικές κεφαλίδες που αποστέλλονται με κάθε αίτημα. Χρησιμοποιήστε τες αν το Lidarr βρίσκεται πίσω από αντίστροφο διακομιστή μεσολάβησης, για παράδειγμα Cloudflare Access ή Authelia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encabezados opcionales que se envían con cada solicitud. Úsalos si Lidarr está detrás de un proxy inverso, por ejemplo Cloudflare Access o Authelia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En-têtes facultatifs envoyés à chaque requête. Utilisez-les si Lidarr est derrière un reverse proxy, par exemple Cloudflare Access ou Authelia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intestazioni facoltative inviate con ogni richiesta. Usale se Lidarr è dietro un reverse proxy, ad esempio Cloudflare Access o Authelia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのリクエストとともに送信される任意のヘッダーです。Lidarrがリバースプロキシ（例：Cloudflare AccessやAuthelia）の背後にある場合に使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随每个请求发送的可选标头。如果 Lidarr 位于反向代理（例如 Cloudflare Access 或 Authelia）之后，请使用这些标头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨每個請求傳送的選用標頭。如果 Lidarr 位於反向代理（例如 Cloudflare Access 或 Authelia）之後，請使用這些標頭。"
          }
        }
      }
    },
