    "The mood playlists already on your server are left untouched. They will keep updating from your library tags instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stimmungs-Playlists auf deinem Server bleiben unverändert. Sie werden künftig aus deinen Bibliothek-Tags aktualisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λίστες διάθεσης που υπάρχουν ήδη στον διακομιστή σου παραμένουν ως έχουν. Θα ενημερώνονται πλέον από τις ετικέτες της βιβλιοθήκης σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas de estado de ánimo que ya están en tu servidor se mantienen intactas. Seguirán actualizándose a partir de las etiquetas de tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les playlists d'ambiance déjà présentes sur ton serveur restent intactes. Elles continueront de se mettre à jour à partir des tags de ta bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le playlist per atmosfera già presenti sul tuo server restano intatte. Continueranno ad aggiornarsi dai tag della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー上にあるムードのプレイリストはそのまま残ります。今後はライブラリのタグから更新されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器上已有的心情播放列表保持不变，之后将改用音乐库标签继续更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器上既有的心情播放列表維持不變，之後將改用音樂庫標籤繼續更新。"
          }
        }
      }
    },
