    },
    "The server took too long to respond. Check your network and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat zu lange für eine Antwort gebraucht. Netzwerk prüfen und erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής άργησε πολύ να απαντήσει. Ελέγξτε το δίκτυό σας και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor tardó demasiado en responder. Comprueba tu red e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a mis trop de temps à répondre. Vérifiez votre réseau et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha impiegato troppo tempo a rispondere. Controlla la rete e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバの応答に時間がかかりすぎました。ネットワークを確認してもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器响应时间过长。请检查你的网络后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器回應時間過長。請檢查你的網路後再試一次。"
          }
        }
      }
    },
    "The server transcodes to the chosen tier for each network. Original streams your files untouched (lossless); a lighter tier saves cellular data and lowers decoding load. Applies to the next track." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server transkodiert für jedes Netzwerk in die gewählte Stufe. Original streamt deine Dateien unverändert (verlustfrei); eine leichtere Stufe spart mobiles Datenvolumen und senkt die Dekodierlast. Gilt für den nächsten Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής επανακωδικοποιεί στο επιλεγμένο επίπεδο για κάθε δίκτυο. Το Πρωτότυπο μεταδίδει τα αρχεία σας ανέπαφα (χωρίς απώλειες)· ένα ελαφρύτερο επίπεδο εξοικονομεί δεδομένα κινητής και μειώνει το φορτίο αποκωδικοποίησης. Ισχύει για το επόμενο κομμάτι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor transcodifica al nivel elegido para cada red. Original transmite tus archivos sin modificar (sin pérdidas); un nivel más ligero ahorra datos móviles y reduce la carga de decodificación. Se aplica a la siguiente pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur transcode vers le niveau choisi pour chaque réseau. Original diffuse vos fichiers tels quels (sans perte) ; un niveau plus léger économise les données mobiles et réduit la charge de décodage. S'applique au titre suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server transcodifica al livello scelto per ogni rete. Original riproduce i tuoi file invariati (senza perdita); un livello più leggero risparmia dati cellulari e riduce il carico di decodifica. Si applica alla traccia successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーはネットワークごとに選択したレベルへトランスコードします。オリジナルはファイルをそのまま（ロスレスで）ストリーミングします。軽いレベルはモバイルデータを節約し、デコード負荷を下げます。次の曲から適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器会针对每种网络转码到所选的等级。原始会原封不动地（无损）串流你的文件；较低的等级可节省蜂窝数据并降低解码负担。将在下一首曲目生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器會針對每種網路轉碼到所選的等級。原始會原封不動地（無損）串流你的檔案；較低的等級可節省行動數據並降低解碼負擔。將於下一首曲目生效。"
          }
        }
      }
    },
    "The server's TLS certificate could not be verified. Check your server's SSL configuration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das TLS-Zertifikat des Servers konnte nicht überprüft werden. SSL-Konfiguration des Servers prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επαλήθευση του πιστοποιητικού TLS του διακομιστή. Ελέγξτε τη ρύθμιση SSL του διακομιστή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el certificado TLS del servidor. Comprueba la configuración SSL de tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat TLS du serveur n'a pas pu être vérifié. Vérifiez la configuration SSL de votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare il certificato TLS del server. Controlla la configurazione SSL del tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバのTLS証明書を検証できませんでした。サーバのSSL設定を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
